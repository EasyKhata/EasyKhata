<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules for Android 6 (M, API 23) through Android 11 (R, API 30).

  Financial data lives in WebView's localStorage / IndexedDB and in Firebase
  Auth's encrypted preferences. We do not back any of it up: the user re-signs
  in on a new device and re-syncs from the server, which is also the recovery
  path if their device is wiped.

  <exclude /> here means "if backup is somehow enabled, exclude this domain".
  Combined with android:allowBackup="false" in the manifest, this is belt-and-
  suspenders against a future-someone re-enabling backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
