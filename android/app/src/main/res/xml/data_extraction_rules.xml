<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+ (S, API 31).
  Two scenarios:
    • cloud-backup: Google Drive / equivalent backup.
    • device-transfer: device-to-device migration (e.g. setting up a new phone).
  We disallow both for financial data — recovery is via re-sign-in + server sync.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
