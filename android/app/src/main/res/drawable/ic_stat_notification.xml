<!--
  Notification status-bar icon.

  Must be a pure-white silhouette on a transparent background — Android masks
  the icon and applies a tint at runtime. Any non-white pixels render as
  white-on-grey blobs in the status bar. We reuse the K-mark shape from the
  launcher foreground, simplified to solid forms only (no orange dot).

  108dp / 100-unit viewport keeps it consistent with the launcher icon's
  proportions; Android scales it down to 24dp / 22dp for the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100"
    android:tint="#FFFFFF">
    <group
        android:translateX="14"
        android:translateY="14"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <!-- Vertical bar of the K -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,18h12a6,6 0 0,1 6,6v52a6,6 0 0,1 -6,6h-12a6,6 0 0,1 -6,-6v-52a6,6 0 0,1 6,-6z" />
        <!-- Top, middle and bottom strokes of the K -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,18h40a6,6 0 0,1 6,6v0a6,6 0 0,1 -6,6h-40a6,6 0 0,1 -6,-6v0a6,6 0 0,1 6,-6z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,44h30a6,6 0 0,1 6,6v0a6,6 0 0,1 -6,6h-30a6,6 0 0,1 -6,-6v0a6,6 0 0,1 6,-6z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,70h40a6,6 0 0,1 6,6v0a6,6 0 0,1 -6,6h-40a6,6 0 0,1 -6,-6v0a6,6 0 0,1 6,-6z" />
        <!-- Two diagonal strokes forming the K -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="12"
            android:strokeLineCap="round"
            android:pathData="M40,50 L74,18" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="12"
            android:strokeLineCap="round"
            android:pathData="M40,50 L74,82" />
    </group>
</vector>
